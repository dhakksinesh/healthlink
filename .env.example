# ==================== LLM — OpenRouter ====================
# Copy to .env and fill OPENROUTER_API_KEY / PINECONE_API_KEY
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=0

# ==================== Pinecone — Vector Store + Embeddings ====================
PINECONE_API_KEY=your_pinecone_key
PINECONE_INDEX_NAME=healthlink
PINECONE_DIMENSION=1024
EMBEDDING_MODEL=llama-text-embed-v2
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine

# ==================== RAG ====================
RAG_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50
LOAD_KB_ON_STARTUP=false

# ==================== Database ====================
DATABASE_URL=sqlite:///./data/healthlink.db
DB_ECHO=False
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# ==================== Security / Rate Limit ====================
SECRET_KEY=dev-secret-key-change-in-production
RATE_LIMIT_MAX=0
RATE_LIMIT_WINDOW=60

# ==================== API / Paths ====================
CORS_ORIGINS=*
LOG_LEVEL=INFO
ENABLE_METRICS=True
API_BASE_URL=http://localhost:8000/api/v1
CLOUD_RUN_URL=https://healthlink-sxc6ezkzvq-uc.a.run.app
CLOUD_RUN_API_URL=https://healthlink-sxc6ezkzvq-uc.a.run.app/api/v1
KB_FILE=./data/symptoms_kb.json
DOCTORS_CSV=./data/doctors.csv
GCP_REGION=us-central1

# ==================== Observability — LangSmith ====================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=healthlink
